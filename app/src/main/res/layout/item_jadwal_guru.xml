<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardJadwalMapel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvJam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="07:30 - 09:00"
            android:textColor="#2563EB"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvMapelKelas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvJam"
            android:text="Matematika - Kelas IX-A"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#0F172A"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Input Nilai ➔"
            android:textColor="#64748B"
            android:textSize="13sp"/>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>