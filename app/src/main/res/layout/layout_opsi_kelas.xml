<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/tvJudulOpsiKelas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Menu Kelola Kelas"
        android:textColor="#1E3A8A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnMenuWaliKelas"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Atur Wali Kelas"
        android:backgroundTint="#1E3A8A"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnMenuTambahJadwal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Tambah Jadwal Pelajaran"
        android:backgroundTint="#0284C7" />
</LinearLayout>