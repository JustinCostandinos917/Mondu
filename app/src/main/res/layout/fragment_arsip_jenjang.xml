<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E3A8A"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/btnBackJenjang"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF"
            android:layout_centerVertical="true"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/btnBackJenjang"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvTitleJenjang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih Jenjang Kelas"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubTitleJenjang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tahun Ajaran 2025/2026"
                android:textColor="#CBD5E1"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Kelas 7 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardKelas7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="Kelas 7"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:drawableEnd="@android:drawable/ic_media_play"
                android:drawableTint="#1E3A8A"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Kelas 8 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardKelas8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="Kelas 8"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:drawableEnd="@android:drawable/ic_media_play"
                android:drawableTint="#1E3A8A"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Kelas 9 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardKelas9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="Kelas 9"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:drawableEnd="@android:drawable/ic_media_play"
                android:drawableTint="#1E3A8A"/>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</LinearLayout>
