<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:background="#E2E8F0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detail Aktivitas"
        android:textColor="#1E293B"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#F1F5F9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Aksi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aksi"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tvDetailAksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menambahkan Guru Baru"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginVertical="12dp"/>

            <!-- Pelaku -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oleh"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tvDetailUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin Justin (admin)"
                android:textColor="#1E3A8A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginVertical="12dp"/>

            <!-- Waktu -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waktu Kejadian"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tvDetailWaktu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hari ini, 09:00"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:layout_marginTop="2dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTutupDetail"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Tutup"
        android:textAllCaps="false"
        app:cornerRadius="12dp"
        app:backgroundTint="#1E3A8A" />

</LinearLayout>