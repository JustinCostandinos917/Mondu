<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="16dp">

    <!-- Judul Halaman -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pengaturan Aplikasi"
        android:textColor="#1E293B"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <!-- Tombol Ganti Password -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_ganti_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ganti Password"
        android:gravity="start|center_vertical"
        android:padding="16dp"
        android:backgroundTint="#FFFFFF"
        android:textColor="#1E293B"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:cornerRadius="100dp"
        android:layout_marginBottom="12dp"
        app:icon="@drawable/ic_lock"
        app:iconTint="#1E293B"
        app:iconPadding="12dp"/>

    <!-- Menu Notifikasi Aplikasi (Sekarang Sempurna Oval Mengikuti Button) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="100dp"
        app:cardElevation="0dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        android:clickable="false"
        android:focusable="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notifikasi Aplikasi"
                android:layout_centerVertical="true"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:drawableStart="@drawable/ic_notifications"
                android:drawablePadding="12dp"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_notifikasi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true"/>

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tombol Hubungi Kami -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_hubungi_kami"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hubungi Kami (Contact Us)"
        android:gravity="start|center_vertical"
        android:padding="16dp"
        android:backgroundTint="#FFFFFF"
        android:textColor="#1E293B"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:cornerRadius="100dp"
        android:layout_marginBottom="12dp"
        app:icon="@drawable/ic_phone"
        app:iconTint="#1E293B"
        app:iconPadding="12dp"/>

    <!-- Tombol Tentang Aplikasi -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_tentang_aplikasi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tentang Aplikasi Mondu"
        android:gravity="start|center_vertical"
        android:padding="16dp"
        android:backgroundTint="#FFFFFF"
        android:textColor="#1E293B"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:cornerRadius="100dp"
        android:layout_marginBottom="24dp"
        app:icon="@drawable/ic_info"
        app:iconTint="#1E293B"
        app:iconPadding="12dp"/>

    <!-- Tombol Keluar Akun -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Log Out"
        android:gravity="start|center_vertical"
        android:padding="16dp"
        android:backgroundTint="#FEE2E2"
        android:textColor="#DC2626"
        app:strokeColor="#FCA5A5"
        app:strokeWidth="1dp"
        app:cornerRadius="100dp"
        app:icon="@drawable/ic_logout"
        app:iconTint="#DC2626"
        app:iconPadding="12dp"/>
</LinearLayout>