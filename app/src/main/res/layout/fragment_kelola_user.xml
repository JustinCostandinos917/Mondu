<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".KelolaUserFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Judul Halaman -->
        <TextView
            android:id="@+id/tvTitleUsers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kelola Data User"
            android:textColor="#1E3A8A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- List Data User -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUsers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/tvTitleUsers"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            tools:listitem="@layout/item_user" />

        <!-- Tombol Tambah User (Floating Action Button) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Tambah User"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="#1E3A8A"
            app:tint="#FFFFFF"
            app:fabSize="normal" />

    </RelativeLayout>
</FrameLayout>