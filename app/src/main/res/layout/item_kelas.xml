<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#F1F5F9"
    app:cardBackgroundColor="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Icon List (Sesuai Gambar) -->
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="Icon Kelas"
            app:tint="#1E3A8A"
            android:layout_marginEnd="16dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Nama Kelas (cth: 7A) -->
            <TextView
                android:id="@+id/tvNamaKelasItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7A"
                android:textColor="#1E3A8A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Nama Wali Kelas -->
            <TextView
                android:id="@+id/tvWaliKelasItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wali Kelas: Budi Setiawan, S.Pd"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Panah Indikator Kecil (Sesuai Gambar) -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_media_play"
            app:tint="#CBD5E1"
            android:alpha="0.7"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>