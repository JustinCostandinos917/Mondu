<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/layoutJadwalHarian"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jadwal Pelajaran Hari Ini"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"/>
            <Button
                android:id="@+id/btnBukaKalender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lihat Kalender"
                android:textSize="12sp"
                android:layout_alignParentEnd="true"
                android:backgroundTint="#1E3A8A"/>
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/pbJadwal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmptyJadwal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tidak ada jadwal untuk hari ini."
            android:textAlignment="center"
            android:layout_marginTop="20dp"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvJadwalSiswa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutFullKalender"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnKembaliKeJadwal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Kembali ke Jadwal"
            android:backgroundTint="#64748B"
            android:layout_marginBottom="16dp"/>

        <CalendarView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="4dp"/>
    </LinearLayout>
</RelativeLayout>
