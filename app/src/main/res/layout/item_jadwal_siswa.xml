<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvWaktuJadwal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:00 - 09:30"
            android:textColor="#2563EB"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvMapelJadwal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvWaktuJadwal"
            android:text="Matematika"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvGuruJadwal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvMapelJadwal"
            android:text="Guru: Budi Santoso, S.Pd"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginTop="2dp"/>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>