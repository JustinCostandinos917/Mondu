<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hubungi Kami"
        android:textColor="#1E293B"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Punya kendala atau pertanyaan seputar Mondu? Kirimkan pesan langsung ke tim kami."
        android:textColor="#64748B"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <!-- Input Pesan Masukan -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_pesan_kontak"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Tulis pesan atau laporan kendala kamu di sini..."
            android:gravity="top|start"
            android:inputType="textMultiLine"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Kirim Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_kirim_pesan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kirim Pesan"
        android:padding="16dp"
        app:cornerRadius="100dp"
        android:backgroundTint="#1E293B"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp"/>

    <!-- Garis Pembatas Hubungi Lewat Sosmed -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_centerVertical="true"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ATAU HUBUNGI VIA "
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#F8FAFC"
            android:layout_centerInParent="true"
            android:paddingHorizontal="8dp"/>
    </RelativeLayout>

    <!-- Tombol WhatsApp -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_whatsapp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WhatsApp Customer Service"
        android:gravity="start|center_vertical"
        android:padding="16dp"
        android:backgroundTint="#FFFFFF"
        android:textColor="#1E293B"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:cornerRadius="100dp"
        android:layout_marginBottom="12dp"
        app:icon="@drawable/ic_whatsapp"
        app:iconTint="#1E293B"
        app:iconPadding="12dp"/>

    <!-- Tombol Instagram -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_instagram"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Instagram Official (@mondu.app)"
        android:gravity="start|center_vertical"
        android:padding="16dp"
        android:backgroundTint="#FFFFFF"
        android:textColor="#1E293B"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:cornerRadius="100dp"
        android:layout_marginBottom="12dp"
        app:icon="@drawable/ic_instagram"
        app:iconTint="#1E293B"
        app:iconPadding="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Instagram Official (@mondu.app)"
        android:gravity="start|center_vertical"
        android:padding="16dp"
        android:backgroundTint="#FFFFFF"
        android:textColor="#1E293B"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:cornerRadius="100dp"
        app:icon="@drawable/ic_email"
        app:iconTint="#1E293B"
        app:iconPadding="12dp"/>
</LinearLayout>