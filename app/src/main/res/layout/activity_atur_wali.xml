<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8FAFC">

    <TextView
        android:id="@+id/tvFormWaliTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Atur Wali Kelas"
        android:textColor="#1E3A8A"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- Dropdown Pilih Guru -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Pilih Guru Menjadi Wali Kelas">

        <AutoCompleteTextView
            android:id="@+id/actvPilihWali"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Tombol Simpan -->
    <Button
        android:id="@+id/btnSimpanWali"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Simpan Wali Kelas"
        android:textStyle="bold"
        android:backgroundTint="#1E3A8A"
        app:cornerRadius="12dp"/>
</LinearLayout>